---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import DocsPageLayout from "zuedocs/layouts/DocsPageLayout.astro";
import { docCategories, siteConfig } from "../../data/docs";
const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
export async function getStaticPaths() {
  return (await getCollection("docs")).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const grouped = docCategories.map((category) => ({ category, entries: docs.filter((doc) => doc.data.category === category) })).filter(group => group.entries.length);
const index = docs.findIndex(doc => doc.id === entry.id);
const previous = docs[index - 1];
const next = docs[index + 1];
const tocHeadings = headings.filter(heading => heading.depth > 1 && heading.depth < 4);
---
<SiteLayout title={`${entry.data.title} | ${siteConfig.name} Docs`} description={entry.data.description}>
  <section class="shell docs-shell">
    <aside class="docs-sidebar" id="docs-sidebar" aria-label="Documentation navigation">
      <button class="sidebar-close" type="button" data-sidebar-dismiss aria-label="Close documentation navigation">Close <span aria-hidden="true">×</span></button>
      <a class="docs-sidebar__eyebrow" href="/docs">← The handbook</a>
      {grouped.map(group => (<div class="docs-sidebar__group"><p>{group.category}</p><ul>{group.entries.map(doc => (<li><a class:list={["docs-sidebar__link", doc.id === entry.id && "is-active"]} href={`/docs/${doc.id}`} aria-current={doc.id === entry.id ? "page" : undefined}>{doc.data.title}</a></li>))}</ul></div>))}
    </aside>
    <article class="docs-article">
      {tocHeadings.length > 0 && <details class="docs-mobile-toc"><summary>On this page</summary><ul>{tocHeadings.filter(heading => heading.depth === 2).map(heading => (<li><a href={`#${heading.slug}`}>{heading.text}</a></li>))}</ul></details>}
      <DocsPageLayout title={entry.data.title} description={entry.data.description} category={entry.data.category}><Content /></DocsPageLayout>
      <nav class="doc-pagination" aria-label="More documentation">
        {previous ? <a href={`/docs/${previous.id}`}><span>← Previous</span>{previous.data.title}</a> : <a href="/docs"><span>← Back</span>The handbook</a>}
        {next ? <a href={`/docs/${next.id}`}><span>Next →</span>{next.data.title}</a> : <a href="/docs"><span>Explore →</span>The handbook</a>}
      </nav>
    </article>
    <aside class="docs-toc" aria-label="On this page"><p class="docs-toc__eyebrow">On this page</p><ul>{tocHeadings.map(heading => (<li class:list={[heading.depth === 3 && "toc-subheading"]}><a href={`#${heading.slug}`}>{heading.text}</a></li>))}</ul></aside>
  </section>
</SiteLayout>
<script>
  import "zuedocs/docsEnhancements";
  import "../../scripts/docsAccessibility";
</script>
