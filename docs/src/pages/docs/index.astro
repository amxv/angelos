---
import Arrow from "../../components/Arrow.astro";
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { docCategories } from "../../data/docs";
const entries = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const grouped = docCategories.map((category) => ({ category, entries: entries.filter((entry) => entry.data.category === category) }));
---
<SiteLayout title="Documentation | Angelos" description="Start with the inbox task you want to finish. Find guides for connecting your agent, reading mail, preparing replies, and running Angelos.">
  <div class="shell">
    <section class="guide-index-header"><p class="eyebrow">The Angelos handbook</p><h1>A clearer inbox<br />starts <em>here.</em></h1><p>Connect your agent, find the right message, and work out what’s next. Start with a guide, then reach for the reference when you need it.</p></section>
    <nav class="guide-entrances" aria-label="Choose a starting point">
      <a href="/docs/quickstart"><span class="path-label">01 / USE ANGELOS</span><h2>Connect your agent <Arrow /></h2><p>Get connected to an existing server and try your first inbox request.</p></a>
      <a href="/docs/agent-guide"><span class="path-label">02 / WORK WITH THE TOOLS</span><h2>Follow the agent guide <Arrow /></h2><p>A practical playbook for choosing tools and handling their results.</p></a>
      <a href="/docs/self-hosting"><span class="path-label">03 / SET UP A SERVER</span><h2>Run your own Angelos <Arrow /></h2><p>Configure a mailbox, access, and a deployment with read-only defaults.</p></a>
    </nav>
    <div class="guide-map">{grouped.filter(group => group.entries.length).map((group) => (
      <section class="guide-map__group"><h2>{group.category}</h2><div>{group.entries.map((entry) => (<a href={`/docs/${entry.id}`}><h3>{entry.data.title} <span aria-hidden="true"><Arrow /></span></h3><p>{entry.data.summary ?? entry.data.description}</p></a>))}</div></section>
    ))}</div>
  </div>
</SiteLayout>
