---
import Arrow from "../../components/Arrow.astro";
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { docCategories } from "../../data/docs";
const entries = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const grouped = docCategories.map((category) => ({ category, entries: entries.filter((entry) => entry.data.category === category) }));
---
<SiteLayout title="Documentation | Angelos" description="Start with the inbox task you want to finish. Find guides for connecting your agent, reading mail, preparing replies, and running Angelos.">
  <div class="shell">
    <section class="guide-index-header"><p class="eyebrow">The Angelos handbook</p><h1>A clearer inbox<br />starts <em>here.</em></h1><p>New here? Connect Your Assistant takes you from your own deployment to your first inbox request. Already connected? Go straight to the inbox guides or Agent playbook.</p></section>
    <a class="setup-feature" href="/docs/quickstart"><div><span class="path-label">THE COMPLETE SETUP GUIDE</span><h2>Connect Your Assistant <Arrow /></h2><p>Your Vercel account. Your mailbox. Your passkey. Everything you need to get Angelos working in ChatGPT, in one place.</p></div><span class="setup-feature__steps">Vercel + Redis<br />Mailbox + sign-in<br />ChatGPT + first read</span></a>
    <nav class="guide-entrances" aria-label="After setup">
      <a href="/docs/inbox-guide"><span class="path-label">01 / USE YOUR INBOX</span><h2>Find your next step <Arrow /></h2><p>Read, search, understand conversations, and organize mail.</p></a>
      <a href="/docs/sending-guide"><span class="path-label">02 / WRITE WITH CARE</span><h2>Prepare a reply <Arrow /></h2><p>Review exactly what will be sent before sending it.</p></a>
      <a href="/docs/agent-guide"><span class="path-label">03 / FOR AGENTS</span><h2>Agent playbook <Arrow /></h2><p>Choose tools and handle results with clear, safe workflows.</p></a>
    </nav>
    <div class="guide-map">{grouped.filter(group => group.entries.length).map((group) => (
      <section class="guide-map__group"><h2>{group.category}</h2><div>{group.entries.map((entry) => (<a href={`/docs/${entry.id}`}><h3>{entry.data.title} <span aria-hidden="true"><Arrow /></span></h3><p>{entry.data.summary ?? entry.data.description}</p></a>))}</div></section>
    ))}</div>
  </div>
</SiteLayout>
