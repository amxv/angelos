---
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">Agent-native email</p>
      <h1>Give agents a clean interface to work with email.</h1>
      <p class="hero__lede">
        Connect an existing mailbox to a private Go MCP server. Read and organize mail,
        prepare reviewed messages, and keep your other mail clients connected.
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href="/docs/overview">Read the overview</a>
        <a class="button button--ghost" href="/docs">Browse the docs</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">Deliberate access</p>
      <ul class="hero__signal-list">
        <li>OAuth-protected access to one configured mailbox.</li>
        <li>Separate opt-ins for mailbox writes and sending.</li>
        <li>Exact prepared payloads and durable dispatch records.</li>
      </ul>
      <div class="hero__terminal">
        <span>$ go test ./...</span>
        <span>$ go run .</span>
        <span>Read access first. Enable changes deliberately.</span>
      </div>
    </aside>
  </section>

  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Documentation</p>
      <h2>Set up a mailbox. Understand every boundary.</h2>
      <p>
        Start with the safety model, configure Spacemail or explicit provider settings,
        and connect through an existing OAuth issuer.
      </p>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
