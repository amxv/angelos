# Configure through your deployment's secret manager. Never commit real values.
MAIL_PROVIDER=spacemail
MAIL_USERNAME=mailbox@example.com
MAIL_PASSWORD=
MAIL_FROM=mailbox@example.com
# Optional comma-separated own addresses excluded from derived reply recipients.
# This does not grant sender authority or change MAIL_FROM.
# MAIL_ALIASES=alias@example.com,other-alias@example.com
MAIL_TIMEOUT=30s
# For custom providers, set MAIL_PROVIDER=custom and both hostnames.
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_TLS_MODE=tls
# SMTP port 587 requires SMTP_TLS_MODE=starttls.

# Gmail / Google Workspace uses the same preset for a Gmail-enabled mailbox.
# MAIL_PROVIDER=gmail
# MAIL_AUTH_MODE=google_oauth2
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Remove MAIL_PASSWORD for Google OAuth. All three Google values are secrets/config
# provisioned directly by the owner, never supplied through MCP arguments.
# Conditional alternative: MAIL_AUTH_MODE=app_password with an eligible Google
# app password in MAIL_PASSWORD; clear all GOOGLE_* credentials in that mode.
# Gmail SMTP saves Sent automatically: use append_sent=false.

# External-issuer mode (default): authorization-code + PKCE S256.
# Audience/resource must exactly equal this deployed MCP URL.
MCP_RESOURCE_URL=https://mail-mcp.example.com/mcp
MCP_OAUTH_ISSUER=https://auth.example.com/
MCP_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
MCP_ALLOWED_SUBJECTS=

# First-party OAuth is opt-in and bound to your explicitly configured HTTPS origin.
# Enabling it requires operator setup; it does not enroll the owner or connect ChatGPT.
ANGELOS_OAUTH_ENABLED=0
# Choose one stable production hostname before enrolling passkeys. No trailing
# slash, path, port, query, or fragment in the lowercase issuer origin. Never
# derive this from request headers or changing Vercel preview deployment URLs.
# When enabling, replace the four MCP_* values above with:
# MCP_RESOURCE_URL=https://your-project.vercel.app/mcp
# MCP_OAUTH_ISSUER=https://your-project.vercel.app
# MCP_OAUTH_JWKS_URL=https://your-project.vercel.app/oauth/jwks.json
# MCP_ALLOWED_SUBJECTS=  # One stable, explicit owner subject, not a generated default.
# Durable P-256 ES256 private key (PKCS#8 or EC PEM) and a unique, stable key ID.
ANGELOS_OAUTH_SIGNING_KEY_PEM=
ANGELOS_OAUTH_SIGNING_KEY_ID=
# Optional JSON object mapping retiring key IDs to PKIX PUBLIC KEY PEM strings.
ANGELOS_OAUTH_VERIFICATION_KEYS_JSON=
# JSON client array; public-client auth method is none, always with PKCE S256.
# Copy exact redirect URIs from the actual ChatGPT connection UI; no wildcards.
# Shape: [{"client_id":"owner-chosen-client","client_name":"ChatGPT","redirect_uris":["EXACT_VERIFIED_HTTPS_CALLBACK"]}]
ANGELOS_OAUTH_CLIENTS_JSON=
# Optional pinned ChatGPT client metadata identity; not dynamic registration.
ANGELOS_OAUTH_CHATGPT_CIMD_ENABLED=0
# Lowercase SHA-256 hex of a high-entropy bootstrap token, never the raw token.
# Use 32-64 random bytes encoded as unpadded base64url; hash that encoded text.
# Enter the raw token only in the owner enrollment UI.
# Remove this hash after first enrollment; preserve Redis's consumed marker.
ANGELOS_OAUTH_BOOTSTRAP_TOKEN_HASH=
# Open https://your-project.vercel.app/oauth/login to enroll the owner.
# Passkey RP ID and browser origin derive from MCP_OAUTH_ISSUER. Cookies stay
# host-only (__Host- prefix), Secure, HttpOnly, and SameSite=Lax. Cookie flags,
# name, and lifetimes are fixed. Use a dedicated Redis database per deployment.
# Changing the origin requires new passkeys and a new ChatGPT connection;
# choose a stable domain and plan state migration before changing it.

# All gates default off. OAuth scope is ALSO required for every call.
MAIL_ENABLE_WRITES=0
MAIL_ENABLE_SEND=0
MAIL_ENABLE_DELETE=0
# First-party OAuth and sending share a compatible Redis REST endpoint with
# atomic EVAL/SET and isolated angelos:oauth:* / angelos:send:* namespaces.
# Prepared full messages are stored for up to 15 minutes before dispatch.
ANGELOS_REDIS_REST_URL=
ANGELOS_REDIS_REST_TOKEN=
