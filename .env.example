# Configure through your deployment's secret manager. Never commit real values.
MAIL_PROVIDER=spacemail
MAIL_USERNAME=mailbox@example.com
MAIL_PASSWORD=
MAIL_FROM=mailbox@example.com
# Optional comma-separated own addresses excluded from derived reply recipients.
# This does not grant sender authority or change MAIL_FROM.
# MAIL_ALIASES=alias@example.com,other-alias@example.com
MAIL_TIMEOUT=30s
# For custom providers, set MAIL_PROVIDER=custom and both hostnames.
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_TLS_MODE=tls
# SMTP port 587 requires SMTP_TLS_MODE=starttls.

# Gmail / Google Workspace uses the same preset for a Gmail-enabled mailbox.
# MAIL_PROVIDER=gmail
# MAIL_AUTH_MODE=google_oauth2
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Remove MAIL_PASSWORD for Google OAuth. All three Google values are secrets/config
# provisioned directly by the owner, never supplied through MCP arguments.
# Conditional alternative: MAIL_AUTH_MODE=app_password with an eligible Google
# app password in MAIL_PASSWORD; clear all GOOGLE_* credentials in that mode.
# Gmail SMTP saves Sent automatically: use append_sent=false.

# Existing OAuth issuer with authorization-code + PKCE S256.
# Audience/resource must exactly equal this deployed MCP URL.
MCP_RESOURCE_URL=https://mail-mcp.example.com/mcp
MCP_OAUTH_ISSUER=https://auth.example.com/
MCP_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
MCP_ALLOWED_SUBJECTS=

# All gates default off. OAuth scope is ALSO required for every call.
MAIL_ENABLE_WRITES=0
MAIL_ENABLE_SEND=0
MAIL_ENABLE_DELETE=0
# Sending requires a compatible Redis REST endpoint with atomic EVAL/SET.
# Prepared full messages are stored for up to 15 minutes before dispatch.
ANGELOS_REDIS_REST_URL=
ANGELOS_REDIS_REST_TOKEN=
